{
  "name": "@SVEN-gateway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.5",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "knip": "knip",
    "db:generate": "set -a && . ./.env && set +a && atlas migrate diff --env local",
    "db:migrate": "set -a && . ./.env && set +a && atlas migrate apply --env local && pnpm db:diesel-schema",
    "atlas:diff": "pnpm db:generate",
    "atlas:status": "set -a && . ./.env && set +a && atlas migrate status --env local",
    "atlas:hash": "atlas migrate hash --dir file://atlas/migrations",
    "atlas:validate": "set -a && . ./.env && set +a && atlas migrate validate --env local",
    "atlas:rebase": "atlas migrate rebase --dir file://atlas/migrations",
    "db:diesel-schema": "cd gateway-api && diesel print-schema > src/schema.rs",
    "db:reset": "gateway-api/scripts/db.sh reset",
    "db:seed": "gateway-api/scripts/db.sh seed",
    "db:reset-and-seed": "gateway-api/scripts/db.sh reset-and-seed"
  },
  "dependencies": {
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "knip": "^6.42.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}